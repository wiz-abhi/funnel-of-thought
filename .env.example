# Funnel of Thought — environment template.
#
#   cp .env.example .env    and fill in the blanks.
#
# .env is gitignored. Nothing in THIS file may ever hold a real secret.

# --- The only LLM in the system -------------------------------------------
# Used exclusively by the OBSERVED agent (agent/), and only when generating a
# batch of traces offline. The shipped tooling — the funnel MCP server, the
# `fot` CLI, the dashboard and the alert — makes zero LLM calls at runtime.
# Free tier is sufficient: ~300-600 calls generates a funnel-sized batch.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Models for the batch generator. The pair matters: two DIFFERENT models is
# what reproduces the OTel GenAI span-name fragmentation ({operation} {model}),
# which is the whole point of the counter-proof funnel.
FOT_MODEL_PRIMARY=gemini-3.1-flash-lite
FOT_MODEL_SWAP=gemini-3.1-flash

# --- SigNoz ---------------------------------------------------------------
# Where the SigNoz UI/API lives. From the host this is localhost:8080; from a
# container on signoz-network it is http://signoz-signoz-0:8080.
SIGNOZ_URL=http://localhost:8080

# Trace Funnels write endpoints (/api/v1/trace-funnels/**) are gated behind
# EditAccess, which an API key does not carry — you need a LOGIN JWT from an
# admin/editor account. Mint one with:
#   scripts/setup.sh --token      (or see the README, "Getting a token")
# JWTs expire; re-mint when the funnel calls start returning 401.
SIGNOZ_JWT=

# An API key (Settings -> API Keys) is enough for READ-only surfaces and for
# the stock SigNoz MCP server. It is NOT enough to create or update a funnel.
SIGNOZ_API_KEY=

# --- OpenTelemetry --------------------------------------------------------
# Where the observed agent ships its spans. Host -> published ingester port.
# From a container on signoz-network use http://signoz-ingester:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# service.name on every span the agent emits. The funnel matches steps on
# (service, span name), so changing this means recreating your funnels.
# The committed funnel, dashboard and alert definitions all key on `fot-agent`.
OTEL_SERVICE_NAME=fot-agent
